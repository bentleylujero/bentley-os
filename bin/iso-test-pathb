#!/usr/bin/env bash
# iso-test-pathb: isolation test for Path B (remote Streamable HTTP MCP + OAuth 2.1).
# Run by Bentley as:  ! bin/iso-test-pathb
# Builds apps/api under a throwaway tag, runs ONE throwaway container on
# bentley-os_backend, drives the whole OAuth + MCP flow from inside it, and checks
# verdicts with jq on the host (no node on the host). Uses a test client named
# iso-pathb-<timestamp> and a test folder iso-pathb-<timestamp>; it never touches
# other oauth rows. Cleanup removes only its own container, image, client and folder.
# Env comes from docker's --env-file; nothing from it is printed.
set -uo pipefail
cd "$(dirname "$0")/.."

NET=bentley-os_backend
API_C=iso-pathb-api
API_IMG=iso-pathb-api:test
STAMP=$(date +%s)
NAME="iso-pathb-$STAMP"
FOLDER="$NAME"
PASS=0
FAIL=0
CID=""

PSQL() { docker exec bentley-os-postgres-1 psql -h 127.0.0.1 -U bentley -d bentley -P pager=off -tA -v ON_ERROR_STOP=1 -c "$1"; }

declare -A OK # proof key -> 0 if its check passed; unset or nonzero means not proven

check() { # check "<label>" <exit-code> [proof-key]
  if [ "$2" -eq 0 ]; then echo "PASS  $1"; PASS=$((PASS+1)); else echo "FAIL  $1"; FAIL=$((FAIL+1)); fi
  [ -n "${3:-}" ] && OK[$3]=$2
  return 0
}

# cnt "<sql>": sets CNT to a non-negative integer, or returns 1 with CNT_ERR holding the psql error / bad output.
cnt() {
  local o rc
  o=$(PSQL "$1" 2>&1); rc=$?
  if [ "$rc" -ne 0 ] || ! [[ "$o" =~ ^[0-9]+$ ]]; then CNT=""; CNT_ERR="${o:-<empty output, rc=$rc>}"; return 1; fi
  CNT="$o"; CNT_ERR=""; return 0
}

# acheck <key> "<label>" "<count sql>" eq|ge <n>
acheck() {
  local key=$1 label=$2 sql=$3 op=$4 want=$5
  if ! cnt "$sql"; then check "$label: psql error or non-integer result: $CNT_ERR" 1 "$key"; return 1; fi
  if [ "$op" = eq ]; then [ "$CNT" -eq "$want" ]; else [ "$CNT" -ge "$want" ]; fi
  check "$label (rows=$CNT)" $? "$key"
}

# claim "<text>" key...: prints under PROVES only if every key passed, else under NOT PROVEN.
PROVEN=(); UNPROVEN=()
claim() {
  local text=$1 k; shift
  for k in "$@"; do
    if [ "${OK[$k]:-1}" -ne 0 ]; then UNPROVEN+=("$text  [failed or not run: $k]"); return; fi
  done
  PROVEN+=("$text")
}

summary() {
  echo "=== result: PASS=$PASS FAIL=$FAIL"
  claim "The api image builds (tsc) and the real routes mount: discovery metadata, /register, /authorize, /token, /mcp." build dist_oauth dist_mcp dist_stdio health prm asm reg_ok
  claim "DCR accepts only the two claude callback URIs; PKCE is S256-only; wrong verifier, code reuse and unregistered redirect are refused." reg_bad asm authz_plain token_wrong_verifier code_reuse authz_bad_redirect
  claim "/authorize refuses requests lacking the Cloudflare Access identity header and requests lacking the CSRF cookie." authz_noheader authz_csrf
  claim "/mcp refuses missing/garbage/revoked tokens with a resource_metadata challenge; a valid token lists exactly the 5 tools." mcp_noauth mcp_badtoken mcp_tools old_revoked
  claim "isExposed() gates the http transport like stdio: list_documents, get_document, search_folder and upload_document on an unexposed folder are refused, audited with transport=http and client_id, and upload stored nothing." mcp_list_docs_unexposed mcp_get_doc_unexposed mcp_search_unexposed mcp_upload_unexposed a_list_docs a_get_doc a_search a_upload upload_no_row upload_no_mcp_row
  claim "Refresh rotation revokes the old pair; reuse of a rotated refresh token revokes every token for the client." refresh_ok old_revoked refresh_reuse after_reuse a_tokens_dead
  claim "Audit ledger carries each oauth.* and mcp.* event, with no raw token fields." a_oauth a_auth_rejected a_list_folders a_no_tokens
  claim "Cleanup removed the test client, folder and documents." clean_client clean_folder clean_docs
  echo "PROVES"
  local x
  for x in "${PROVEN[@]}"; do echo "  - $x"; done
  if [ "${#UNPROVEN[@]}" -gt 0 ]; then
    echo "NOT PROVEN (FAILED)"
    for x in "${UNPROVEN[@]}"; do echo "  - $x"; done
  fi
  cat <<'TXT'
DOES NOT PROVE
  - Cloudflare Access itself: the header was supplied by the test. Whether Access injects it for a real login, and whether Access policies let anonymous claude.ai reach /mcp, /token, /register and /.well-known/* is untested.
  - The public hostname, TLS, or the live OAUTH_ISSUER value (the test used http://iso-pathb-api:3000).
  - claude.ai's real connector handshake, or the 20-client cap and rate limits (not exercised).
  - Anything about the live api container: nothing here is deployed.
TXT
}

cleanup() {
  echo "=== cleanup (only $NAME rows, iso-pathb-* container and image)"
  docker rm -f "$API_C" >/dev/null 2>&1
  docker rmi "$API_IMG" >/dev/null 2>&1
  # oauth codes/tokens cascade from the client row; the match is on this run's exact name.
  local out
  out=$(PSQL "delete from oauth_clients where client_name = '$NAME'; delete from documents where folder = '$FOLDER'; delete from document_folders where name = '$FOLDER' and name like 'iso-pathb-%'" 2>&1) || echo "cleanup psql error: $out"
  docker ps -a --filter "name=iso-pathb-" --format 'left over: {{.Names}}'
  acheck clean_client "cleanup: oauth_clients rows for $NAME gone" "select count(*) from oauth_clients where client_name = '$NAME'" eq 0
  acheck clean_folder "cleanup: document_folders row $FOLDER gone" "select count(*) from document_folders where name = '$FOLDER'" eq 0
  acheck clean_docs "cleanup: documents in folder $FOLDER gone" "select count(*) from documents where folder = '$FOLDER'" eq 0
  summary
  [ "$FAIL" -eq 0 ] && exit 0 || exit 1
}
trap cleanup EXIT

echo "=== HEAD"
git log -1 --format='%h %s'
git status --porcelain | head -10

echo "=== build api (tsc runs inside the build)"
docker build -q -t "$API_IMG" apps/api; check "build api" $? build
[ "$FAIL" -eq 0 ] || { echo "build failed, stopping"; exit 1; }
docker run --rm --entrypoint test "$API_IMG" -f dist/routes/oauth.js; check "dist/routes/oauth.js exists" $? dist_oauth
docker run --rm --entrypoint test "$API_IMG" -f dist/routes/mcp.js; check "dist/routes/mcp.js exists" $? dist_mcp
docker run --rm --entrypoint test "$API_IMG" -f dist/mcp-stdio.js; check "dist/mcp-stdio.js exists" $? dist_stdio

echo "=== start throwaway api on $NET (routes only, no scheduler)"
PSQL "insert into document_folders (name, mcp_exposed) values ('$FOLDER', false)" >/dev/null; check "create unexposed test folder $FOLDER" $?
DOC_ID=$(PSQL "with i as (insert into documents (title, source, mime, body, char_count, folder, embedded_at) values ('iso-pathb seed', 'iso-test', 'text/plain', 'iso-pathb seed body', 19, '$FOLDER', now()) returning id) select id from i" 2>&1)
[[ "$DOC_ID" =~ ^[0-9a-f-]{36}$ ]]; check "seed one document in unexposed folder (id=$DOC_ID)" $?
[ "$FAIL" -eq 0 ] || { echo "seed failed, stopping"; exit 1; }
docker run -d --name "$API_C" --network "$NET" --env-file .env -e OAUTH_ISSUER="http://$API_C:3000" "$API_IMG" \
  node --input-type=module -e "
import { serve } from '@hono/node-server';
import { Hono } from 'hono';
import { routes } from './dist/routes/index.js';
const app = new Hono(); app.route('/', routes);
serve({ fetch: app.fetch, port: 3000 }, () => console.log('iso api up'));
" >/dev/null; check "start api" $?
ok=1
for i in $(seq 1 30); do
  docker exec "$API_C" node -e "fetch('http://localhost:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" 2>/dev/null && { ok=0; break; }
  sleep 1
done
check "api /health" $ok health
if [ "$FAIL" -ne 0 ]; then echo "--- api logs"; docker logs --tail 40 "$API_C" 2>&1; exit 1; fi

T0=$(PSQL "select now()")
echo "=== audit window starts $T0, client name $NAME, folder $FOLDER"

echo "=== full flow, driven from inside the container"
OUT=$(docker exec -i -e NAME="$NAME" -e F="$FOLDER" -e DOC_ID="$DOC_ID" "$API_C" node --input-type=module - <<'JS'
import { createHash, randomBytes } from 'node:crypto';
const B = 'http://localhost:3000';
const REDIR = 'https://claude.ai/api/mcp/auth_callback';
const ID_HDR = { 'Cf-Access-Authenticated-User-Email': 'iso-test@example.invalid' };
const out = {};
const j = async (r) => { const t = await r.text(); try { return JSON.parse(t); } catch { return t; } };

let r = await fetch(`${B}/.well-known/oauth-protected-resource`); let b = await j(r);
out.prm = [r.status, b.resource, b.authorization_servers];
r = await fetch(`${B}/.well-known/oauth-authorization-server`); b = await j(r);
out.asm = [r.status, b.code_challenge_methods_supported, b.token_endpoint_auth_methods_supported];

const reg = (uris, name) => fetch(`${B}/register`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ client_name: name, redirect_uris: uris }) });
r = await reg(['https://evil.example/cb'], process.env.NAME); out.reg_bad = [r.status];
r = await reg([REDIR], process.env.NAME); b = await j(r);
const CID = b.client_id; out.reg_ok = [r.status, !!CID, b.token_endpoint_auth_method]; out.client_id = CID;

const verifier = () => randomBytes(32).toString('base64url');
const chal = (v) => createHash('sha256').update(v).digest('base64url');
const q = (v, extra = {}) => new URLSearchParams({ client_id: CID, redirect_uri: REDIR, response_type: 'code', code_challenge: chal(v), code_challenge_method: 'S256', state: 'st-123', ...extra });

const v0 = verifier();
r = await fetch(`${B}/authorize?${q(v0)}`); out.authz_noheader = [r.status];
r = await fetch(`${B}/authorize?${q(v0, { redirect_uri: 'https://evil.example/cb' })}`, { headers: ID_HDR }); out.authz_bad_redirect = [r.status];
r = await fetch(`${B}/authorize?${q(v0, { code_challenge_method: 'plain' })}`, { headers: ID_HDR, redirect: 'manual' }); out.authz_plain_rejected = [r.status, (r.headers.get('location') || '').includes('error=invalid_request')];

// POST without a CSRF cookie must fail even with the identity header.
const post = (v, cookie, csrf, decision = 'approve') => fetch(`${B}/authorize`, {
  method: 'POST', redirect: 'manual',
  headers: { ...ID_HDR, 'content-type': 'application/x-www-form-urlencoded', ...(cookie ? { cookie } : {}) },
  body: new URLSearchParams({ client_id: CID, redirect_uri: REDIR, response_type: 'code', code_challenge: chal(v), code_challenge_method: 'S256', state: 'st-123', scope: 'mcp', csrf, decision }),
});
r = await post(v0, '', 'x'); out.authz_post_no_csrf = [r.status];

async function getCode(v, decision = 'approve') {
  const g = await fetch(`${B}/authorize?${q(v)}`, { headers: ID_HDR });
  const html = await g.text();
  const cookie = (g.headers.getSetCookie()[0] || '').split(';')[0];
  const csrf = (/name="csrf" value="([^"]+)"/.exec(html) || [])[1] || '';
  const p = await post(v, cookie, csrf, decision);
  const loc = new URL(p.headers.get('location') || 'http://x/');
  return { get: g.status, consent: html.includes('Authorize connector'), status: p.status, code: loc.searchParams.get('code'), state: loc.searchParams.get('state'), error: loc.searchParams.get('error') };
}
const tok = (params) => fetch(`${B}/token`, { method: 'POST', headers: { 'content-type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ client_id: CID, ...params }) });

let d = await getCode(verifier(), 'deny'); out.authz_denied = [d.get, d.status, d.error, d.state];
d = await getCode(verifier()); out.authz_ok = [d.get, d.consent, d.status, !!d.code, d.state];
r = await tok({ grant_type: 'authorization_code', code: d.code, redirect_uri: REDIR, code_verifier: verifier() }); out.token_wrong_verifier = [r.status, (await j(r)).error];

const v1 = verifier(); d = await getCode(v1);
r = await tok({ grant_type: 'authorization_code', code: d.code, redirect_uri: REDIR, code_verifier: v1 }); b = await j(r);
out.token_ok = [r.status, b.token_type, b.expires_in, !!b.access_token, !!b.refresh_token];
const A1 = b.access_token, R1 = b.refresh_token;
r = await tok({ grant_type: 'authorization_code', code: d.code, redirect_uri: REDIR, code_verifier: v1 }); out.code_reuse = [r.status, (await j(r)).error];

const mcp = (method, params, tokn, id = 1) => fetch(`${B}/mcp`, {
  method: 'POST',
  headers: { 'content-type': 'application/json', accept: 'application/json, text/event-stream', ...(tokn ? { authorization: `Bearer ${tokn}` } : {}) },
  body: JSON.stringify({ jsonrpc: '2.0', id, method, params }),
});
r = await mcp('tools/list', {}, null); out.mcp_noauth = [r.status, r.headers.get('www-authenticate')];
r = await mcp('tools/list', {}, 'not-a-real-token'); out.mcp_badtoken = [r.status];
r = await mcp('initialize', { protocolVersion: '2025-06-18', capabilities: {}, clientInfo: { name: 'iso', version: '0' } }, A1); b = await j(r); out.mcp_init = [r.status, b?.result?.serverInfo?.name];
r = await mcp('tools/list', {}, A1, 2); b = await j(r); out.mcp_tools = [r.status, (b?.result?.tools || []).map((t) => t.name).sort()];
r = await mcp('tools/call', { name: 'list_folders', arguments: {} }, A1, 3); b = await j(r); out.mcp_list_folders = [r.status, b?.result?.isError ?? false, (b?.result?.content?.[0]?.text || '').includes(process.env.F)];
r = await mcp('tools/call', { name: 'list_documents', arguments: { folder: process.env.F } }, A1, 4); b = await j(r); out.mcp_list_docs_unexposed = [r.status, b?.result?.isError === true];
r = await mcp('tools/call', { name: 'get_document', arguments: { document_id: process.env.DOC_ID } }, A1, 8); b = await j(r); out.mcp_get_doc_unexposed = [r.status, b?.result?.isError === true];
r = await mcp('tools/call', { name: 'search_folder', arguments: { folder: process.env.F, query: 'iso pathb probe' } }, A1, 9); b = await j(r); out.mcp_search_unexposed = [r.status, b?.result?.isError === true];
r = await mcp('tools/call', { name: 'upload_document', arguments: { folder: process.env.F, title: 'iso-pathb upload probe', content: 'iso-pathb upload probe content that must never be stored' } }, A1, 10); b = await j(r); out.mcp_upload_unexposed = [r.status, b?.result?.isError === true];

r = await tok({ grant_type: 'refresh_token', refresh_token: R1 }); b = await j(r);
out.refresh_ok = [r.status, !!b.access_token, !!b.refresh_token, b.refresh_token !== R1];
const A2 = b.access_token, R2 = b.refresh_token;
r = await mcp('tools/list', {}, A1, 5); out.old_access_revoked = [r.status];
r = await mcp('tools/list', {}, A2, 6); out.new_access_works = [r.status];
r = await tok({ grant_type: 'refresh_token', refresh_token: R1 }); out.refresh_reuse = [r.status, (await j(r)).error];
r = await mcp('tools/list', {}, A2, 7); out.after_reuse_access_dead = [r.status];
r = await tok({ grant_type: 'refresh_token', refresh_token: R2 }); out.after_reuse_refresh_dead = [r.status];
console.log(JSON.stringify(out));
JS
)
echo "$OUT"
echo "$OUT" | jq -e . >/dev/null || { echo "FAIL  flow output is not JSON, stopping"; docker logs --tail 40 "$API_C" 2>&1; exit 1; }
CID=$(echo "$OUT" | jq -r '.client_id')

v() { echo "$OUT" | jq -e "$1" >/dev/null; check "$2" $? "${3:-}"; }
v '.prm[0]==200 and (.prm[1]|endswith("/mcp")) and (.prm[2]|length==1)' "protected-resource metadata served" prm
v '.asm[0]==200 and .asm[1]==["S256"] and .asm[2]==["none"]' "authorization-server metadata: S256 only, public clients" asm
v '.reg_bad[0]==400' "register: non-claude redirect URI rejected" reg_bad
v '.reg_ok[0]==201 and .reg_ok[1]==true and .reg_ok[2]=="none"' "register: valid redirect URI accepted, public client" reg_ok
v '.authz_noheader[0]==403' "authorize without Access header: 403" authz_noheader
v '.authz_bad_redirect[0]==400' "authorize with unregistered redirect_uri: 400, no redirect" authz_bad_redirect
v '.authz_plain_rejected==[302,true]' "authorize with PKCE method plain rejected" authz_plain
v '.authz_post_no_csrf[0]==400' "authorize POST without CSRF cookie rejected" authz_csrf
v '.authz_denied==[200,302,"access_denied","st-123"]' "authorize deny: access_denied with state passed through"
v '.authz_ok==[200,true,302,true,"st-123"]' "authorize approve: consent page, 302 with code and state"
v '.token_wrong_verifier==[400,"invalid_grant"]' "token: wrong PKCE verifier rejected" token_wrong_verifier
v '.token_ok==[200,"Bearer",3600,true,true]' "token: code + PKCE verifier issues bearer, 1h, refresh token"
v '.code_reuse==[400,"invalid_grant"]' "token: authorization code reuse rejected" code_reuse
v '.mcp_noauth[0]==401 and (.mcp_noauth[1]|test("resource_metadata=.*oauth-protected-resource"))' "/mcp without token: 401 with resource_metadata" mcp_noauth
v '.mcp_badtoken[0]==401' "/mcp with garbage token: 401" mcp_badtoken
v '.mcp_init[0]==200 and .mcp_init[1]=="bentley-os-folders"' "/mcp initialize with bearer"
v '.mcp_tools[0]==200 and .mcp_tools[1]==["get_document","list_documents","list_folders","search_folder","upload_document"]' "/mcp tools/list returns exactly the 5 tools" mcp_tools
v '.mcp_list_folders==[200,false,false]' "list_folders OK and does not show the unexposed test folder"
v '.mcp_list_docs_unexposed==[200,true]' "list_documents on unexposed folder returns isError" mcp_list_docs_unexposed
v '.mcp_get_doc_unexposed==[200,true]' "get_document on a doc in the unexposed folder returns isError" mcp_get_doc_unexposed
v '.mcp_search_unexposed==[200,true]' "search_folder on unexposed folder returns isError" mcp_search_unexposed
v '.mcp_upload_unexposed==[200,true]' "upload_document to unexposed folder returns isError" mcp_upload_unexposed
v '.refresh_ok==[200,true,true,true]' "refresh: rotation issues a new, different pair" refresh_ok
v '.old_access_revoked[0]==401 and .new_access_works[0]==200' "refresh: old access revoked, new access works" old_revoked
v '.refresh_reuse==[400,"invalid_grant"]' "refresh: reuse of rotated token rejected" refresh_reuse
v '.after_reuse_access_dead[0]==401 and .after_reuse_refresh_dead[0]==400' "refresh reuse revoked every token for the client" after_reuse

echo "=== audit rows (window since $T0, this client only)"
PSQL "select id, action, coalesce(target,''), coalesce(outcome,''), payload->>'transport', payload->>'client_id' from audit_log where at >= '$T0' and (payload->>'client_id' = '$CID' or target = '$CID' or action in ('mcp.auth_rejected','oauth.register')) order by id" || echo "audit listing failed (psql error above)"
J="payload->>'transport'='http' and payload->>'client_id'='$CID'"
acheck a_list_docs "audit: mcp.list_documents rejected_not_allowed, transport=http, client_id=$CID" "select count(*) from audit_log where at >= '$T0' and action='mcp.list_documents' and outcome='rejected_not_allowed' and target='$FOLDER' and $J" eq 1
# get_document's real outcome string (apps/api/src/mcp-tools.ts) is rejected_not_found_or_not_allowed, target = document id.
acheck a_get_doc "audit: mcp.get_document rejected_not_found_or_not_allowed (actual app string), target=doc id, transport=http, client_id" "select count(*) from audit_log where at >= '$T0' and action='mcp.get_document' and outcome='rejected_not_found_or_not_allowed' and target='$DOC_ID' and $J" eq 1
acheck a_search "audit: mcp.search_folder rejected_not_allowed, transport=http, client_id" "select count(*) from audit_log where at >= '$T0' and action='mcp.search_folder' and outcome='rejected_not_allowed' and target='$FOLDER' and $J" eq 1
acheck a_upload "audit: mcp.upload_document rejected_not_allowed, transport=http, client_id" "select count(*) from audit_log where at >= '$T0' and action='mcp.upload_document' and outcome='rejected_not_allowed' and target='$FOLDER' and $J" eq 1
acheck upload_no_row "db: upload_document created no document row (only the seed remains in $FOLDER)" "select count(*) from documents where folder='$FOLDER'" eq 1
acheck upload_no_mcp_row "db: no document with source='mcp' in $FOLDER" "select count(*) from documents where folder='$FOLDER' and source='mcp'" eq 0
oauth_ok=0
for act in oauth.register oauth.authorize_approved oauth.authorize_denied oauth.token_issued oauth.token_refreshed oauth.token_rejected; do
  acheck "a_$act" "audit: $act present" "select count(*) from audit_log where at >= '$T0' and action='$act'" ge 1
  [ "${OK[a_$act]:-1}" -eq 0 ] || oauth_ok=1
done
OK[a_oauth]=$oauth_ok
acheck a_auth_rejected "audit: mcp.auth_rejected present (>=2)" "select count(*) from audit_log where at >= '$T0' and action='mcp.auth_rejected'" ge 2
acheck a_list_folders "audit: mcp.list_folders carries transport=http and client_id" "select count(*) from audit_log where at >= '$T0' and action='mcp.list_folders' and $J" eq 1
acheck a_no_tokens "audit: no raw token fields in payloads" "select count(*) from audit_log where at >= '$T0' and payload::text ~* '(access_token|refresh_token|code_verifier)\"'" eq 0
acheck a_tokens_dead "db: no live tokens left for test client" "select count(*) from oauth_tokens where client_id='$CID' and revoked_at is null" eq 0
# the result summary and the cleanup assertions run from the EXIT trap, after cleanup.
