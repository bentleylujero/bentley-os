#!/usr/bin/env bash
# Bentley OS — session-start: emit ground-truth header from the box.
# Read-only. Paste output at the top of a new Claude session.
set -euo pipefail
cd "$(dirname "$0")/.."

git fetch origin --quiet 2>/dev/null || true

HEAD_SHORT=$(git rev-parse --short HEAD)
SYNC=$(git status -sb | head -1)
MIGRATIONS=$(ls supabase/migrations/ | wc -l | tr -d ' ')
SERVICES=$(docker compose ps --status running | tail -n +2 | wc -l | tr -d ' ')

read -r EMAILS CLASSIFIED EMBEDDED ACTIONS EVENTS TASKS STALE_PROPOSED AUTO_APPROVED <<<"$(
  docker exec bentley-os-postgres-1 psql -h 127.0.0.1 -U bentley -d bentley -P pager=off -tA -F' ' -c "
    SELECT
      (SELECT count(*) FROM emails),
      (SELECT count(*) FROM emails WHERE classified_at IS NOT NULL),
      (SELECT count(*) FROM emails WHERE embedded_at IS NOT NULL),
      (SELECT count(*) FROM actions),
      (SELECT count(*) FROM calendar_events),
      (SELECT count(*) FROM tasks),
      (SELECT count(*) FROM actions WHERE status = 'proposed' AND created_at < now() - interval '15 minutes'),
      (SELECT count(*) FROM audit_log WHERE action = 'action.approved' AND payload->>'by' = 'marionette');"
)"

cat <<REPORT
=== BENTLEY OS — GROUND TRUTH @ $(date -u +%Y-%m-%dT%H:%MZ) ===
generated_at: $(date -u +%Y-%m-%d)
head:         $HEAD_SHORT
git_sync:     $SYNC
migrations:   $MIGRATIONS
services_up:  $SERVICES
emails:       $EMAILS
classified:   $CLASSIFIED
embedded:     $EMBEDDED   (gap from emails is normal — cron drains on next tick)
actions:      $ACTIONS
events:       $EVENTS
tasks:        $TASKS
stale_props:  $STALE_PROPOSED   (proposed >15min — nonzero = M5 crash window or an untapped button)
auto_approved:$AUTO_APPROVED   (lifetime count, by='marionette')
=== paste this block at the start of a Claude session ===
REPORT
